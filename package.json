{
  "name": "oracle-lens",
  "version": "0.2.0",
  "description": "Local-only inventory and stats viewer for your own Riot Games accounts.",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently -k -n RENDERER,MAIN,PRELOAD,ELECTRON -c blue,green,yellow,magenta \"npm:dev:renderer\" \"npm:dev:main\" \"npm:dev:preload\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.main.json -w --preserveWatchOutput",
    "dev:preload": "vite build --config vite.preload.config.mts --watch",
    "dev:electron": "wait-on tcp:5173 dist/main/index.js dist/preload/index.js dist/shared/ipc.js && cross-env NODE_ENV=development electron .",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "vite build --config vite.preload.config.mts && tsc -p tsconfig.preload.json",
    "build": "npm run build:renderer && npm run build:main && npm run build:preload",
    "package": "npm run build && electron-builder"
  },
  "keywords": [],
  "author": "KeremEB",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "html2canvas-pro": "^2.3.5",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jszip": "^3.10.1",
    "league-connect": "^6.0.0-rc13",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.oraclelens.app",
    "productName": "Oracle Lens",
    "copyright": "Copyright © 2026 KeremEB",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/oraclelens.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
